# Merchant-specific environment variables for GAMAPAY-USDT production
# Base variables are loaded from ../../frontend-env/.env.base.gamapay-usdt

REACT_APP_API_URL=${REACT_APP_API_HOST}/api/v1/merchant
REACT_APP_API_FILE=${REACT_APP_API_HOST}/v1/api-document-download

# Disable react-scripts built-in ESLint (incompatible with ESLint v9)
DISABLE_ESLINT_PLUGIN=true
