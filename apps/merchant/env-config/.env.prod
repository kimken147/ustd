# Merchant-specific environment variables for prod (test site)
# Base variables are loaded from ../../.env/.env.base.prod

REACT_APP_API_URL=${REACT_APP_API_HOST}/api/v1/merchant
REACT_APP_API_FILE=${REACT_APP_API_HOST}/v1/api-document

# Disable react-scripts built-in ESLint (incompatible with ESLint v9)
DISABLE_ESLINT_PLUGIN=true
