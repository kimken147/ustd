# Admin-specific environment variables for GAMAPAY-USDT production
# Base variables are loaded from ../../frontend-env/.env.base.gamapay-usdt

REACT_APP_API_URL=${REACT_APP_API_HOST}/api/v1/admin
REACT_APP_HOST=${REACT_APP_API_HOST}
REACT_APP_IS_PAUFEN=true

# Disable react-scripts built-in ESLint (incompatible with ESLint v9)
DISABLE_ESLINT_PLUGIN=true
