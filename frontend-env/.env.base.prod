# Shared environment variables for prod (test site)
# Used by both admin and merchant apps

# API Host (base URL)
REACT_APP_API_HOST=https://ustd-dev-api.morganpay168.com

# Branding
REACT_APP_LOGO_SRC=/logo/LOGO-01.png
REACT_APP_LOGO_MINI_SRC=/logo/LOGO-01-mini.png
REACT_APP_FAVICON_SRC=/favicon.ico
REACT_APP_TITLE=USTD-Dev

# Region
REACT_APP_REGION=PH

CI=false

# Laravel Reverb WebSocket
REACT_APP_REVERB_KEY=ustd-prod-key
REACT_APP_REVERB_HOST=ustd-dev-api.morganpay168.com
REACT_APP_REVERB_PORT=443
REACT_APP_REVERB_SCHEME=https
