# Shared environment variables for GAMAPAY-USDT production
# Used by both admin and merchant apps

# API Host (base URL) — update after EB environment is ready
REACT_APP_API_HOST=https://api.gamapay777.com

# Branding
REACT_APP_LOGO_SRC=/logo/GAMAPAY.png
REACT_APP_LOGO_MINI_SRC=/logo/LOGO-01-mini.png
REACT_APP_FAVICON_SRC=/favicon.ico
REACT_APP_TITLE=GAMA

# Region
REACT_APP_REGION=PH

CI=false
