# Shared environment variables for local development
# Used by both admin and merchant apps

# API Host (base URL) - adjust to your local API
REACT_APP_API_HOST=http://ustd.test

# Branding
REACT_APP_LOGO_SRC=/logo/LOGO-01.png
REACT_APP_LOGO_MINI_SRC=/logo/top365pay-logo-mini.png
REACT_APP_FAVICON_SRC=/favicon.ico

# Region
REACT_APP_REGION=CN

# TRON network (mainnet | nile | shasta)
REACT_APP_TRON_NETWORK=nile

# Laravel Reverb WebSocket
REACT_APP_REVERB_KEY=ustd-local-key
REACT_APP_REVERB_HOST=ustd.test
REACT_APP_REVERB_PORT=9001
REACT_APP_REVERB_SCHEME=http
